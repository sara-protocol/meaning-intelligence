# ============================================================================
# 意义智能 / Meaning Intelligence —— Git 忽略规则
# 说明与理由写在每条规则旁，便于后来者判断"该不该改这里"。
# ============================================================================

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python

# 虚拟环境（开发者的本地环境不入库）
.venv/
venv/
env/
ENV/

# Python 构建与打包产物
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------- 发布产物：有意入库
# 例外！whitepaper/dist/ 是**发布产物**，必须入库：
#   - 它是白皮书的正式交付物（中英双语 DOCX / PDF），读者与引用者需要能直接下载；
#   - 生成它的脚本会随理论版本演进，保留已发布版本的字节可以让"某个版本到底写了什么"
#     这个问题有确定答案，而不是只能靠重新构建去猜。
# 因此先让上面的 `dist/` 规则命中，再把 whitepaper/dist/ 及其中内容显式放回来。
# 注意：目录本身必须先被重新包含，否则 `!whitepaper/dist/**` 不会生效。
!whitepaper/dist/
!whitepaper/dist/**

# whitepaper/figures/ 同样有意入库：插图由 make_figures.py 生成，但它依赖本机字体，
# 在不同平台上渲染结果可能不同。把已生成的 PNG 一起入库，DOCX 的构建结果才可复现。
# （若你只是想本地重画插图，运行 python whitepaper/make_figures.py 覆盖即可。）

# ---------------------------------------------------------------- Manim / 渲染中间产物
# media/ 是 Manim 的渲染中间目录：每次渲染都会写入大量临时帧、片段与缓存，
# 它们（1）体积大且内容随分辨率/帧率变化；（2）可由 msi/scenes/ 下的场景源码完整重建；
# （3）在跨平台 diff 中没有评审价值。因此整目录忽略。
media/
media/**/*

# ---------------------------------------------------------------- 渲染成片：有意入库
# 例外说明：早期版本按"视频动辄数十 MB"的假设忽略了 *.mp4。实测本项目
# msi/scenes/ 在 -ql（480p15）下产出的成片约 0.9 MB，体积代价可以接受，
# 而它是演示页的核心内容——入库后全新克隆打开页面即可直接播放六幕动画。
# 因此这里把该成片显式放回（先忽略再取反，且被取反的路径不能落在被忽略的目录内）。
*.mp4
*.mkv
*.mov
*.webm
!msi/MeaningIntelligenceScene.mp4

# ---------------------------------------------------------------- QA / 临时产物
# 这些不是项目内容，只是开发过程中产生的一次性文件：
#   preview-*    用 LibreOffice 渲染出来的逐页预览图（按版本号累积，很快上百 MB）
#   _verify_*    tools/verify_html.py 在目标目录旁写出的临时 JS 文件
#   *.orig/*.rej 打补丁的残留
# 加这条规则是因为曾经把 QA 预览目录渲进仓库内部，污染了推送清单。
preview-*/
_verify_*/
_verify_*.js
*.orig
*.rej

# ---------------------------------------------------------------- IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------- 操作系统垃圾文件
# Windows 缩略图缓存、macOS Finder 元数据、Linux 桌面环境残留
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------- 本地临时件
*.log
*.tmp
timeline.local.json
# 一次性备份目录（不进仓，用 mi_v2_incoming 里对应的源文件即可复原）
msi_v0.2_backup/

